---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../content/site';
import { photos } from '../content/photos';

// Gap between slogan words. Kept here rather than in CSS because the delay
// has to be emitted per-word as a real time value — see the note on
// .slogan__word for why calc() from an index does not work.
const SLOGAN_STAGGER_MS = 520;

// Title leads with the name (what people search) and carries the ward,
// which is how municipal races are actually looked up. Kept under ~60
// characters so it is not truncated in results.
const title = `${site.candidate} — ${site.ward}, ${site.city}`;
const description =
  `Jamie Scrimger is a candidate for ${site.ward} Councillor in ${site.city}. ` +
  `Listen. Respect. Deliver. — 15+ years in emergency management.`;
---

<Base title={title} description={description}>
  <header class="nav">
    <div class="shell nav__inner">
      <a class="nav__mark" href="#top">{site.candidate}</a>
      <nav aria-label="Primary">
        <ul class="nav__list">
          {site.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero section--soft" id="top">
      <div class="shell hero__inner">
        <div class="hero__copy" data-reveal>
          <p class="eyebrow">{site.ward} · {site.city}</p>
          {/*
            The visible H1 is the slogan, but "Listen. Respect. Deliver."
            names neither the candidate nor the city — poor for search and
            for a screen reader landing on the page. The real H1 text is
            the full name and office, visually hidden; the slogan follows
            as styled display text inside it.
          */}
          <h1 class="slogan">
            <span class="visually-hidden">
              {site.candidate} — candidate for {site.ward} Councillor, {site.city}
            </span>
            <span aria-hidden="true" class="slogan__words">
              {site.hero.slogan.map((word, i) => (
                <span class="slogan__word" style={`--word-delay:${i * SLOGAN_STAGGER_MS}ms`}>
                  {word}
                </span>
              ))}
            </span>
          </h1>
          <p class="lede">{site.hero.intro}</p>
          <div class="actions">
            <a class="btn btn--solid" href={site.hero.primaryCta.href}>
              {site.hero.primaryCta.label}
            </a>
            <a class="btn btn--quiet" href={site.hero.secondaryCta.href}>
              {site.hero.secondaryCta.label}
            </a>
          </div>
        </div>
        <div class="hero__portrait" data-reveal data-reveal-delay="480">
          <Photo
            src={photos.hero.src}
            alt={photos.hero.alt}
            ratio="4 / 5"
            priority
            sizes="(min-width: 52rem) 42vw, 100vw"
          />
        </div>
      </div>
    </section>

    <!-- Opening statement -->
    <section class="section section--deep">
      <div class="shell opening">
        <h2 data-reveal>{site.opening.heading}</h2>
        <div class="opening__body" data-reveal data-reveal-delay="380">
          {site.opening.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- The three commitments -->
    <section class="section" id="commitment">
      <div class="shell">
        {site.commitments.map((c, i) => (
          <article class="commitment" data-reveal>
            <div class="commitment__head">
              <span class="commitment__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="commitment__key">{c.key}</h2>
            </div>
            <div class="commitment__body">
              <p class="commitment__lead">{c.lead}</p>
              {c.body.map((para) => <p>{para}</p>)}
              <p class="commitment__pledge">{c.pledge}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- About: the person, placed after the message and before the policy -->
    <section class="section section--soft" id="about">
      <div class="shell about">
        {/* Two separate slots rather than one block: on mobile the second
            photo moves BELOW the bio, so a reader is not made to scroll
            past two large images before reaching any text. */}
        <div class="about__media about__media--lead" data-reveal>
          <Photo
            src={photos.about[0].src}
            alt={photos.about[0].alt}
            ratio="4 / 5"
            sizes="(min-width: 52rem) 30vw, (min-width: 34rem) 45vw, 100vw"
          />
        </div>

        <div class="about__copy" data-reveal data-reveal-delay="340">
          <h2>{site.about.heading}</h2>
          <p class="about__lead">{site.about.lead}</p>

          <dl class="facts">
            {site.about.facts.map((fact) => (
              <div class="facts__item">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>

          {site.about.groups.map((group) => (
            <div class="about__group">
              <h3>{group.title}</h3>
              {group.body.map((para) => <p>{para}</p>)}
            </div>
          ))}
        </div>

        <div class="about__media about__media--trail" data-reveal>
          <Photo
            src={photos.about[1].src}
            alt={photos.about[1].alt}
            ratio="4 / 5"
            sizes="(min-width: 52rem) 30vw, (min-width: 34rem) 45vw, 100vw"
          />
        </div>
      </div>
    </section>

    <!-- Priority themes -->
    <section class="section section--tint" id="priorities">
      <div class="shell">
        <h2 data-reveal>Priorities</h2>
        <ul class="themes">
          {site.priorities.map((p, i) => (
            <li class="theme" data-reveal data-reveal-delay={(i % 3) * 320}>
              <h3>{p.title}</h3>
              <p class="theme__areas">{p.areas.join(' · ')}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Closing commitment -->
    <section class="section section--deep">
      <div class="shell closing" data-reveal>
        <p class="closing__eyebrow">{site.closing.heading}</p>
        <ul class="closing__lines">
          {site.closing.lines.map((line) => <li>{line}</li>)}
        </ul>
        <p class="closing__tagline">{site.closing.tagline}</p>
      </div>
    </section>

    <!-- Get in touch -->
    <section class="section section--soft" id="contact">
      <div class="shell involved" data-reveal>
        <h2>{site.contact.heading}</h2>
        <div class="actions">
          <a class="btn btn--solid" href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </div>

        <div class="donate">
          <h3 class="donate__heading">{site.contact.donations.heading}</h3>
          <p class="donate__body">{site.contact.donations.body}</p>
        </div>

        {/* The date voters actually need. <time> gives it a machine-readable
            value as well as the display string. */}
        <p class="election">
          Election day is{' '}
          <time datetime={site.election.date}>{site.election.dateLabel}</time>.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <p class="footer__name">{site.candidate} — {site.ward} Councillor, {site.city}</p>
      <p class="footer__legal">{site.footer.disclaimer}</p>
    </div>
  </footer>
</Base>

<style>
  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface-soft-translucent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-faint);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-xs);
  }
  .nav__mark {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .nav__list {
    display: none;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__list a {
    color: var(--color-heading);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav__list a:hover {
    text-decoration: underline;
  }
  @media (min-width: 46rem) {
    .nav__list {
      display: flex;
    }
  }

  /* Hero */
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--space-2xl);
    }
  }

  /* The slogan is the campaign's whole identity — three words, stacked so
     each lands as its own statement rather than a run-on line. */
  .slogan {
    display: block;
  }
  /* The words are now nested one level deeper, under the aria-hidden
     wrapper, so the column stacking moves here. */
  .slogan__words {
    display: flex;
    flex-direction: column;
  }
  .slogan__word {
    display: block;
  }
  /* The per-word reveal rules live in global.css, NOT here: Astro scopes
     component styles with a [data-astro-cid-*] attribute, and .reveal-ready
     sits on <html>, which carries no such attribute — so a scoped rule for
     it silently never matches. */

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }
  .lede {
    font-size: var(--step-1);
    margin-top: var(--space-m);
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .btn {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--ui-duration) var(--ease-out);
  }
  .btn--solid {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .btn--solid:hover {
    background: var(--color-accent-hover);
  }
  .btn--quiet {
    border: 1px solid var(--color-border-strong);
    color: var(--color-heading);
  }
  .btn--quiet:hover {
    background: var(--color-surface-tint);
  }

  /* Sections */
  .section--soft {
    background: var(--color-surface-soft);
  }
  .section--tint {
    background: var(--color-surface-tint);
  }
  .section--deep {
    background: var(--color-accent-hover);
  }

  /* Opening */
  /* On the deep band the default heading/body colours would be near-black
     on navy, so this section inverts its own text. */
  .opening {
    display: grid;
    gap: var(--space-m);
    color: var(--color-text-muted-on-inverse);
  }
  .opening :global(h2) {
    color: var(--color-text-on-inverse);
  }
  @media (min-width: 52rem) {
    .opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-2xl);
    }
  }
  .opening__body p + p {
    margin-top: var(--space-s);
  }

  /* Commitments */
  .commitment {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .commitment:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 46rem) {
    .commitment {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      gap: var(--space-xl);
    }
  }
  .commitment__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }
  /* --color-accent, not --color-decorative: the decorative tone is fill-only
     (2.26 on the base, failing even large-text). See the note in tokens.css. */
  .commitment__num {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .commitment__key {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .commitment__lead {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    margin-bottom: var(--space-s);
    text-wrap: balance;
  }
  .commitment__body p + p {
    margin-top: var(--space-s);
  }
  /* The pledge is the line that should stick — set apart from the prose. */
  .commitment__pledge {
    margin-top: var(--space-m);
    padding-left: var(--space-s);
    border-left: 3px solid var(--color-accent);
    color: var(--color-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* About */
  .about {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 52rem) {
    .about {
      /* Portrait narrower than the copy — the text is the substance here,
         and a 50/50 split would make the photo overstate its role. */
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      align-items: start;
      gap: var(--space-2xl);
    }
  }
  /* Two photos: always one above the other — stacked in the left column
     on desktop, and in the flow of the single column below 52rem. */
  /*
   * Below 52rem the section is a single column and the photos sit where
   * they fall in the markup: one above the bio, one after it. That keeps
   * a phone reader from scrolling past two full-height images before any
   * text appears.
   */
  .about__media {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 52rem) {
    /* Desktop returns both photos to the left column, stacked one directly
       above the other. Grid placement does this without reordering the
       markup, so the mobile reading order stays intact.

       The photos share a single auto row and stack inside it via their own
       gap: giving each its own grid row let the copy's height stretch row 1
       and pull them apart. */
    .about {
      /* Rows 1 and 2 hold the two photos at their natural heights; row 3
         absorbs any leftover height from the taller copy column, so the
         photos stay stacked together instead of being pushed apart. */
      grid-template-rows: auto auto 1fr;
    }
    .about__media--lead {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
    }
    .about__media--trail {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
    .about__copy {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  .about__copy h2 {
    margin-bottom: var(--space-s);
  }

  /* Each movement of the bio — roots, career, leadership. */
  .about__group {
    margin-top: var(--space-l);
  }
  .about__group h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .about__group p + p {
    margin-top: var(--space-s);
  }
  .about__lead {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    margin-bottom: var(--space-m);
    text-wrap: balance;
  }
  .about__copy p + p {
    margin-top: var(--space-s);
  }

  /* Credibility markers — short checkable facts, set apart from the prose */
  .facts {
    display: grid;
    gap: var(--space-s);
    /* Sits between the lead and the prose, fenced by rules top and bottom
       so it reads as a summary strip rather than a stray list. */
    margin: var(--space-l) 0 0;
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 34rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: var(--space-m);
    }
  }
  .facts__item dt {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .facts__item dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  /* Priority themes */
  .themes {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .themes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .theme {
    padding: var(--space-l);
    background: var(--color-on-accent);
    border-radius: var(--radius);
  }
  .theme h3 {
    font-size: var(--step-1);
  }
  .theme__areas {
    margin-top: var(--space-xs);
    color: var(--color-text);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  /* Closing */
  .closing {
    text-align: center;
  }
  .closing__eyebrow {
    margin-inline: auto;
    /* Muted-on-inverse (5.35); the decorative tone would be 2.74 and fail. */
    color: var(--color-surface-tint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .closing__lines {
    margin: var(--space-l) auto 0;
    padding: 0;
    list-style: none;
  }
  .closing__lines li {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.35;
    text-wrap: balance;
  }
  .closing__tagline {
    margin: var(--space-l) auto 0;
    color: var(--color-surface-tint);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }

  /* Get involved */
  .involved {
    max-width: 60ch;
  }
  .involved .lede {
    margin-top: var(--space-s);
  }
  .donate {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
  .donate__heading {
    font-size: var(--step-1);
  }
  .donate__body {
    margin-top: var(--space-xs);
  }
  .election {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
    color: var(--color-heading);
    font-size: var(--step-1);
    font-family: var(--font-display);
  }

  /* Footer */
  .footer {
    padding-block: var(--space-xl);
    background: var(--color-heading);
    color: var(--color-surface-tint);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .footer__name {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .footer__legal {
    font-size: var(--step--1);
  }
</style>

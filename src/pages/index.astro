---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../content/site';
import { photos } from '../content/photos';

// Gap between slogan words. Kept here rather than in CSS because the delay
// has to be emitted per-word as a real time value — see the note on
// .slogan__word for why calc() from an index does not work.
const SLOGAN_STAGGER_MS = 520;

const title = `${site.candidate} — ${site.office}, ${site.city}`;
const description =
  'Listen. Respect. Deliver. Jamie Scrimger for Thunder Bay City Council.';
---

<Base title={title} description={description}>
  <header class="nav">
    <div class="shell nav__inner">
      <a class="nav__mark" href="#top">{site.candidate}</a>
      <nav aria-label="Primary">
        <ul class="nav__list">
          {site.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" id="top">
      <div class="shell hero__inner">
        <div class="hero__copy" data-reveal>
          <p class="eyebrow">{site.office} · {site.city}</p>
          <h1 class="slogan">
            {site.hero.slogan.map((word, i) => (
              <span class="slogan__word" style={`--word-delay:${i * SLOGAN_STAGGER_MS}ms`}>
                {word}
              </span>
            ))}
          </h1>
          <p class="lede">{site.hero.intro}</p>
          <div class="actions">
            <a class="btn btn--solid" href={site.hero.primaryCta.href}>
              {site.hero.primaryCta.label}
            </a>
            <a class="btn btn--quiet" href={site.hero.secondaryCta.href}>
              {site.hero.secondaryCta.label}
            </a>
          </div>
        </div>
        <div class="hero__portrait" data-reveal data-reveal-delay="480">
          <Photo
            src={photos.hero.src}
            alt={photos.hero.alt}
            ratio="4 / 5"
            priority
            sizes="(min-width: 52rem) 42vw, 100vw"
          />
        </div>
      </div>
    </section>

    <!-- Opening statement -->
    <section class="section section--tint">
      <div class="shell opening">
        <h2 data-reveal>{site.opening.heading}</h2>
        <div class="opening__body" data-reveal data-reveal-delay="380">
          {site.opening.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- The three commitments -->
    <section class="section" id="commitment">
      <div class="shell">
        {site.commitments.map((c, i) => (
          <article class="commitment" data-reveal>
            <div class="commitment__head">
              <span class="commitment__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="commitment__key">{c.key}</h2>
            </div>
            <div class="commitment__body">
              <p class="commitment__lead">{c.lead}</p>
              {c.body.map((para) => <p>{para}</p>)}
              <p class="commitment__pledge">{c.pledge}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- About: the person, placed after the message and before the policy -->
    <section class="section" id="about">
      <div class="shell about">
        <div class="about__media" data-reveal>
          {photos.about.map((photo, i) => (
            <Photo
              src={photo.src}
              alt={photo.alt}
              ratio="4 / 5"
              sizes="(min-width: 52rem) 30vw, (min-width: 34rem) 45vw, 100vw"
              data-reveal
              data-reveal-delay={i * 320}
            />
          ))}
        </div>

        <div class="about__copy" data-reveal data-reveal-delay="340">
          <h2>{site.about.heading}</h2>
          <p class="about__lead">{site.about.lead}</p>

          <dl class="facts">
            {site.about.facts.map((fact) => (
              <div class="facts__item">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>

          {site.about.groups.map((group) => (
            <div class="about__group">
              <h3>{group.title}</h3>
              {group.body.map((para) => <p>{para}</p>)}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Priority themes -->
    <section class="section section--tint" id="priorities">
      <div class="shell">
        <h2 data-reveal>Priorities</h2>
        <ul class="themes">
          {site.priorities.map((p, i) => (
            <li class="theme" data-reveal data-reveal-delay={(i % 3) * 320}>
              <h3>{p.title}</h3>
              <p class="theme__areas">{p.areas.join(' · ')}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Closing commitment -->
    <section class="section section--deep">
      <div class="shell closing" data-reveal>
        <p class="closing__eyebrow">{site.closing.heading}</p>
        <ul class="closing__lines">
          {site.closing.lines.map((line) => <li>{line}</li>)}
        </ul>
        <p class="closing__tagline">{site.closing.tagline}</p>
      </div>
    </section>

    <!-- Get involved -->
    <section class="section" id="involved">
      <div class="shell involved" data-reveal>
        <h2>{site.involved.heading}</h2>
        <p class="lede">{site.involved.body}</p>
        <div class="actions">
          <a class="btn btn--solid" href={site.involved.ctaHref}>{site.involved.ctaLabel}</a>
          <a class="btn btn--quiet" href={`mailto:${site.involved.email}`}>
            {site.involved.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <p class="footer__name">{site.candidate} — {site.office}, {site.city}</p>
      <p class="footer__legal">{site.footer.disclaimer}</p>
    </div>
  </footer>
</Base>

<style>
  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface-translucent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-faint);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-xs);
  }
  .nav__mark {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .nav__list {
    display: none;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__list a {
    color: var(--color-heading);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav__list a:hover {
    text-decoration: underline;
  }
  @media (min-width: 46rem) {
    .nav__list {
      display: flex;
    }
  }

  /* Hero */
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--space-2xl);
    }
  }

  /* The slogan is the campaign's whole identity — three words, stacked so
     each lands as its own statement rather than a run-on line. */
  .slogan {
    display: flex;
    flex-direction: column;
  }
  .slogan__word {
    display: block;
  }
  /* The per-word reveal rules live in global.css, NOT here: Astro scopes
     component styles with a [data-astro-cid-*] attribute, and .reveal-ready
     sits on <html>, which carries no such attribute — so a scoped rule for
     it silently never matches. */

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }
  .lede {
    font-size: var(--step-1);
    margin-top: var(--space-m);
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .btn {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--ui-duration) var(--ease-out);
  }
  .btn--solid {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .btn--solid:hover {
    background: var(--color-accent-hover);
  }
  .btn--quiet {
    border: 1px solid var(--color-border-strong);
    color: var(--color-heading);
  }
  .btn--quiet:hover {
    background: var(--color-surface-tint);
  }

  /* Sections */
  .section--tint {
    background: var(--color-surface-tint);
  }
  .section--deep {
    background: var(--color-accent-hover);
  }

  /* Opening */
  .opening {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 52rem) {
    .opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-2xl);
    }
  }
  .opening__body p + p {
    margin-top: var(--space-s);
  }

  /* Commitments */
  .commitment {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .commitment:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 46rem) {
    .commitment {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      gap: var(--space-xl);
    }
  }
  .commitment__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }
  /* --color-accent, not --color-decorative: the decorative tone is fill-only
     (2.26 on the base, failing even large-text). See the note in tokens.css. */
  .commitment__num {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .commitment__key {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .commitment__lead {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    margin-bottom: var(--space-s);
    text-wrap: balance;
  }
  .commitment__body p + p {
    margin-top: var(--space-s);
  }
  /* The pledge is the line that should stick — set apart from the prose. */
  .commitment__pledge {
    margin-top: var(--space-m);
    padding-left: var(--space-s);
    border-left: 3px solid var(--color-accent);
    color: var(--color-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* About */
  .about {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 52rem) {
    .about {
      /* Portrait narrower than the copy — the text is the substance here,
         and a 50/50 split would make the photo overstate its role. */
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      align-items: start;
      gap: var(--space-2xl);
    }
  }
  /* Two photos: side by side on mid widths, stacked in the sticky column
     on desktop where they sit against a long run of bio copy. */
  .about__media {
    display: grid;
    gap: var(--space-s);
  }
  @media (min-width: 34rem) and (max-width: 51.999rem) {
    .about__media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The bio runs well past the photos' height, which would otherwise leave
     a long empty gutter. Sticking the column keeps them with the reader.
     Offset clears the sticky nav. */
  @media (min-width: 52rem) {
    .about__media {
      position: sticky;
      top: calc(var(--space-3xl) + var(--space-s));
    }
  }

  .about__copy h2 {
    margin-bottom: var(--space-s);
  }

  /* Each movement of the bio — roots, career, leadership. */
  .about__group {
    margin-top: var(--space-l);
  }
  .about__group h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .about__group p + p {
    margin-top: var(--space-s);
  }
  .about__lead {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    margin-bottom: var(--space-m);
    text-wrap: balance;
  }
  .about__copy p + p {
    margin-top: var(--space-s);
  }

  /* Credibility markers — short checkable facts, set apart from the prose */
  .facts {
    display: grid;
    gap: var(--space-s);
    /* Sits between the lead and the prose, fenced by rules top and bottom
       so it reads as a summary strip rather than a stray list. */
    margin: var(--space-l) 0 0;
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 34rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: var(--space-m);
    }
  }
  .facts__item dt {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .facts__item dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  /* Priority themes */
  .themes {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .themes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .theme {
    padding: var(--space-l);
    background: var(--color-on-accent);
    border-radius: var(--radius);
  }
  .theme h3 {
    font-size: var(--step-1);
  }
  .theme__areas {
    margin-top: var(--space-xs);
    color: var(--color-text);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  /* Closing */
  .closing {
    text-align: center;
  }
  .closing__eyebrow {
    margin-inline: auto;
    /* Muted-on-inverse (5.35); the decorative tone would be 2.74 and fail. */
    color: var(--color-surface-tint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .closing__lines {
    margin: var(--space-l) auto 0;
    padding: 0;
    list-style: none;
  }
  .closing__lines li {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.35;
    text-wrap: balance;
  }
  .closing__tagline {
    margin: var(--space-l) auto 0;
    color: var(--color-surface-tint);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }

  /* Get involved */
  .involved {
    max-width: 60ch;
  }
  .involved .lede {
    margin-top: var(--space-s);
  }

  /* Footer */
  .footer {
    padding-block: var(--space-xl);
    background: var(--color-heading);
    color: var(--color-surface-tint);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .footer__name {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .footer__legal {
    font-size: var(--step--1);
  }
</style>

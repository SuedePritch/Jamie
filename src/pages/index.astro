---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../content/site';

// Gap between slogan words. Kept here rather than in CSS because the delay
// has to be emitted per-word as a real time value — see the note on
// .slogan__word for why calc() from an index does not work.
const SLOGAN_STAGGER_MS = 280;

const title = `${site.candidate} — ${site.office}, ${site.city}`;
const description =
  'Listen. Respect. Deliver. Jamie Scrimger for Thunder Bay City Council.';
---

<Base title={title} description={description}>
  <header class="nav">
    <div class="shell nav__inner">
      <a class="nav__mark" href="#top">{site.candidate}</a>
      <nav aria-label="Primary">
        <ul class="nav__list">
          {site.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" id="top">
      <div class="shell hero__inner">
        <div class="hero__copy" data-reveal>
          <p class="eyebrow">{site.office} · {site.city}</p>
          <h1 class="slogan">
            {site.hero.slogan.map((word, i) => (
              <span class="slogan__word" style={`--word-delay:${i * SLOGAN_STAGGER_MS}ms`}>
                {word}
              </span>
            ))}
          </h1>
          <p class="lede">{site.hero.intro}</p>
          <div class="actions">
            <a class="btn btn--solid" href={site.hero.primaryCta.href}>
              {site.hero.primaryCta.label}
            </a>
            <a class="btn btn--quiet" href={site.hero.secondaryCta.href}>
              {site.hero.secondaryCta.label}
            </a>
          </div>
        </div>
        <div class="hero__portrait" data-reveal data-reveal-delay="260">
          <Placeholder ratio="4 / 5" label="Portrait of Jamie" />
        </div>
      </div>
    </section>

    <!-- Opening statement -->
    <section class="section section--tint">
      <div class="shell opening">
        <h2 data-reveal>{site.opening.heading}</h2>
        <div class="opening__body" data-reveal data-reveal-delay="200">
          {site.opening.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- The three commitments -->
    <section class="section" id="commitment">
      <div class="shell">
        {site.commitments.map((c, i) => (
          <article class="commitment" data-reveal>
            <div class="commitment__head">
              <span class="commitment__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="commitment__key">{c.key}</h2>
            </div>
            <div class="commitment__body">
              <p class="commitment__lead">{c.lead}</p>
              {c.body.map((para) => <p>{para}</p>)}
              <p class="commitment__pledge">{c.pledge}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Priority themes -->
    <section class="section section--tint" id="priorities">
      <div class="shell">
        <h2 data-reveal>Priorities</h2>
        <ul class="themes">
          {site.priorities.map((p, i) => (
            <li class="theme" data-reveal data-reveal-delay={(i % 3) * 170}>
              <h3>{p.title}</h3>
              <p class="theme__areas">{p.areas.join(' · ')}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Community photography -->
    <section class="section" id="community">
      <div class="shell">
        <h2 data-reveal>In the community</h2>
        <div class="gallery">
          {[
            'Community event',
            'Door knocking',
            'Local business',
            'Neighbourhood',
            'Volunteers',
            'Town hall',
          ].map((label, i) => (
            <Placeholder
              ratio={i % 3 === 0 ? '4 / 5' : '1 / 1'}
              label={label}
              class="gallery__item"
              data-reveal
              data-reveal-delay={(i % 3) * 170}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Closing commitment -->
    <section class="section section--deep">
      <div class="shell closing" data-reveal>
        <p class="closing__eyebrow">{site.closing.heading}</p>
        <ul class="closing__lines">
          {site.closing.lines.map((line) => <li>{line}</li>)}
        </ul>
        <p class="closing__tagline">{site.closing.tagline}</p>
      </div>
    </section>

    <!-- Get involved -->
    <section class="section" id="involved">
      <div class="shell involved" data-reveal>
        <h2>{site.involved.heading}</h2>
        <p class="lede">{site.involved.body}</p>
        <div class="actions">
          <a class="btn btn--solid" href={site.involved.ctaHref}>{site.involved.ctaLabel}</a>
          <a class="btn btn--quiet" href={`mailto:${site.involved.email}`}>
            {site.involved.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <p class="footer__name">{site.candidate} — {site.office}, {site.city}</p>
      <p class="footer__legal">{site.footer.disclaimer}</p>
    </div>
  </footer>
</Base>

<style>
  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface-translucent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-faint);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-xs);
  }
  .nav__mark {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .nav__list {
    display: none;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__list a {
    color: var(--color-heading);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav__list a:hover {
    text-decoration: underline;
  }
  @media (min-width: 46rem) {
    .nav__list {
      display: flex;
    }
  }

  /* Hero */
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--space-2xl);
    }
  }

  /* The slogan is the campaign's whole identity — three words, stacked so
     each lands as its own statement rather than a run-on line. */
  .slogan {
    display: flex;
    flex-direction: column;
  }
  .slogan__word {
    display: block;
  }
  /* The per-word reveal rules live in global.css, NOT here: Astro scopes
     component styles with a [data-astro-cid-*] attribute, and .reveal-ready
     sits on <html>, which carries no such attribute — so a scoped rule for
     it silently never matches. */

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }
  .lede {
    font-size: var(--step-1);
    margin-top: var(--space-m);
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .btn {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--ui-duration) var(--ease-out);
  }
  .btn--solid {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .btn--solid:hover {
    background: var(--color-accent-hover);
  }
  .btn--quiet {
    border: 1px solid var(--color-border-strong);
    color: var(--color-heading);
  }
  .btn--quiet:hover {
    background: var(--color-surface-tint);
  }

  /* Sections */
  .section--tint {
    background: var(--color-surface-tint);
  }
  .section--deep {
    background: var(--color-accent-hover);
  }

  /* Opening */
  .opening {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 52rem) {
    .opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-2xl);
    }
  }
  .opening__body p + p {
    margin-top: var(--space-s);
  }

  /* Commitments */
  .commitment {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .commitment:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 46rem) {
    .commitment {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      gap: var(--space-xl);
    }
  }
  .commitment__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }
  /* --color-accent, not --color-decorative: the decorative tone is fill-only
     (2.26 on the base, failing even large-text). See the note in tokens.css. */
  .commitment__num {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .commitment__key {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .commitment__lead {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    margin-bottom: var(--space-s);
    text-wrap: balance;
  }
  .commitment__body p + p {
    margin-top: var(--space-s);
  }
  /* The pledge is the line that should stick — set apart from the prose. */
  .commitment__pledge {
    margin-top: var(--space-m);
    padding-left: var(--space-s);
    border-left: 3px solid var(--color-accent);
    color: var(--color-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* Priority themes */
  .themes {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .themes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .theme {
    padding: var(--space-l);
    background: var(--color-on-accent);
    border-radius: var(--radius);
  }
  .theme h3 {
    font-size: var(--step-1);
  }
  .theme__areas {
    margin-top: var(--space-xs);
    color: var(--color-text);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }
  @media (min-width: 34rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Closing */
  .closing {
    text-align: center;
  }
  .closing__eyebrow {
    margin-inline: auto;
    /* Muted-on-inverse (5.35); the decorative tone would be 2.74 and fail. */
    color: var(--color-surface-tint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .closing__lines {
    margin: var(--space-l) auto 0;
    padding: 0;
    list-style: none;
  }
  .closing__lines li {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.35;
    text-wrap: balance;
  }
  .closing__tagline {
    margin: var(--space-l) auto 0;
    color: var(--color-surface-tint);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }

  /* Get involved */
  .involved {
    max-width: 60ch;
  }
  .involved .lede {
    margin-top: var(--space-s);
  }

  /* Footer */
  .footer {
    padding-block: var(--space-xl);
    background: var(--color-heading);
    color: var(--color-surface-tint);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .footer__name {
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .footer__legal {
    font-size: var(--step--1);
  }
</style>
